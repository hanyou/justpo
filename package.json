{
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@remix-run/cloudflare": "^2.17.5",
    "@remix-run/react": "^2.17.5",
    "@remix-run/server-runtime": "^2.17.5",
    "@shopify/app-bridge": "^3.7.12",
    "@shopify/polaris": "^13.9.5",
    "@shopify/shopify-api": "^15.0.1",
    "@shopify/shopify-app-remix": "^6.0.2",
    "@zxing/browser": "^0.2.1",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.33.0"
  },
  "description": "JustPO — minimalist purchase orders + barcode receiving for Shopify. Built per PRD v1.1.",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@expo-google-fonts/noto-sans-sc": "^0.4.4",
    "@remix-run/cloudflare": "^2.17.5",
    "@remix-run/dev": "^2.17.5",
    "@remix-run/react": "^2.17.5",
    "@remix-run/server-runtime": "^2.17.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "subset-font": "^2.9.0",
    "typescript": "^5.7.2",
    "vite": "^6.2.2",
    "vite-tsconfig-paths": "^6.1.1",
    "wrangler": "^3.114.17"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "name": "justpo",
  "private": true,
  "scripts": {
    "build": "remix vite:build",
    "build:cjk-font": "node scripts/build-cjk-font.mjs",
    "db:migrate": "wrangler d1 execute justpo-db --file=./migrations/0001_init.sql",
    "deploy": "npm run build && wrangler deploy ./worker.ts",
    "dev": "remix vite:dev",
    "preview": "npm run build && wrangler dev ./worker.ts",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "version": "0.1.0"
}
